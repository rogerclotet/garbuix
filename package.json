{
	"name": "garbuix",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "NODE_OPTIONS='--import ./instrument.server.ts' vite dev --port 3000",
		"build": "vite build",
		"prebuild": "tsx scripts/write-build-version.ts && tsx scripts/download-catalan-dictionary.ts --if-missing",
		"start": "node --import ./instrument.server.ts .output/server/index.mjs",
		"download-dict": "tsx scripts/download-catalan-dictionary.ts --force",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"analytics:export": "tsx scripts/export-usage.ts",
		"auth:migrate:plan": "auth migrate plan",
		"auth:migrate:apply": "auth migrate apply",
		"preview": "vite preview",
		"backfill:puzzles": "node --import tsx --import ./instrument.server.ts scripts/backfill-daily-puzzles.ts",
		"backfill:leaderboard": "tsx scripts/backfill-leaderboard.ts",
		"backfill:difficulty": "tsx scripts/backfill-difficulty.ts",
		"backfill:account-issuer": "tsx scripts/backfill-account-issuer.ts",
		"clues:backfill": "node --import tsx --import ./instrument.server.ts scripts/backfill-clues.ts",
		"delete:puzzle-day": "tsx scripts/delete-puzzle-day.ts",
		"reset:user-progress": "tsx scripts/reset-user-progress.ts",
		"seed:clue-request": "tsx scripts/seed-clue-request.ts",
		"analyze:randomness": "tsx scripts/analyze-daily-randomness.ts",
		"analyze:difficulty": "tsx scripts/analyze-difficulty.ts",
		"test:generation-stats": "tsx scripts/test-generation-stats.ts",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"ensure-dict": "tsx scripts/download-catalan-dictionary.ts --if-missing",
		"ci:lint": "pnpm lint && pnpm check && pnpm ensure-dict && pnpm typecheck",
		"typecheck": "tsc --noEmit",
		"prepare": "husky",
		"postbuild": "tsx scripts/glitchtip-sourcemaps.ts",
		"glitchtip:upload": "tsx scripts/glitchtip-sourcemaps.ts --upload-only"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.128.0",
		"@base-ui/react": "^1.8.0",
		"@faker-js/faker": "^10.6.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@sentry/tanstackstart-react": "^10.75.3",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/query-db-collection": "^1.2.15",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router": "^1.170.39",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.58",
		"@tanstack/react-store": "^0.11.1",
		"@tanstack/router-plugin": "^1.168.40",
		"@tanstack/store": "^0.11.1",
		"better-auth": "^1.7.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"h3": "2.0.1-rc.32",
		"ioredis": "^5.11.1",
		"lucide-react": "^1.48.0",
		"next-themes": "^0.4.6",
		"nitro": "3.0.260903-beta",
		"postgres": "^3.4.9",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@rolldown/plugin-babel": "^0.2.4",
		"@sentry/cli": "^2.58.6",
		"@tanstack/devtools-event-client": "^0.5.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"auth": "^1.7.6",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.11",
		"fast-xml-parser": "^5.11.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.6.0",
		"sharp": "^0.35.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "25.2.x"
	}
}
