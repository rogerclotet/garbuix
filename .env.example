APP_PORT=3000
PG_PORT=5432
POSTGRES_DB=paraules
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paraules
# Redis backs the realtime leaderboard and peer clue requests. Optional, but
# those features no-op without it. For local dev run a Redis (e.g.
# `docker run --rm -p 6379:6379 redis:7-alpine`) and point this at it.
REDIS_URL=redis://localhost:6379
# Signs session cookies. The value below is public (it lives in this repo) and
# works only for local development — the app refuses to start with it when
# NODE_ENV=production. Before deploying, replace it:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-replace-1234
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTHOG_KEY=
# Daily aggregate counters, disabled by default. No browser PostHog SDK.
ANALYTICS_ENABLED=false
POSTHOG_HOST=https://eu.i.posthog.com
# Anthropic API key for AI-generated word clues (pistes)
ANTHROPIC_API_KEY=

# GlitchTip. One public DSN covers browser and server; blank disables reporting.
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=development
# Fraction of performance traces to retain. Error events are always captured.
GLITCHTIP_TRACES_SAMPLE_RATE=0.1
# Structured logs require GlitchTip 6.1+. Captures console.warn/error too.
GLITCHTIP_ENABLE_LOGS=false
# Build-only source-map uploads. Token scopes: project:releases and org:read.
# Docker reads these through a BuildKit secret; they are never sent to browsers.
GLITCHTIP_URL=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
GLITCHTIP_AUTH_TOKEN=
