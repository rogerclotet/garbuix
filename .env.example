APP_PORT=3000
PG_PORT=5432
POSTGRES_DB=paraules
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paraules
# Redis backs the realtime leaderboard and peer clue requests. Optional, but
# those features no-op without it. For local dev run a Redis (e.g.
# `docker run --rm -p 6379:6379 redis:7-alpine`) and point this at it.
REDIS_URL=redis://localhost:6379
# Signs session cookies. The value below is public (it lives in this repo) and
# works only for local development — the app refuses to start with it when
# NODE_ENV=production. Before deploying, replace it:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-replace-1234
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Anthropic API key for AI-generated word clues (pistes)
ANTHROPIC_API_KEY=
# Error reporting uses the Sentry SDK with either Sentry or GlitchTip.
# Leave DSNs empty to disable reporting. Use the project DSN, not the instance URL.
# Browser DSN is public and baked into the build; server DSN is read at runtime.
VITE_SENTRY_DSN=https://aaa5d5691ba54047bdf600b7d9b04aee@glitchtip.clotet.dev/1
SENTRY_DSN=https://aaa5d5691ba54047bdf600b7d9b04aee@glitchtip.clotet.dev/1
# Optional source-map uploads. Use your GlitchTip instance URL (or https://sentry.io/)
# and the organization/project slugs and API token from that same instance.
SENTRY_URL=https://glitchtip.clotet.dev/
SENTRY_ORG=clotetdev
SENTRY_PROJECT=garbuix
# Build-only secret. Never VITE_-prefix it. Compose passes it as a BuildKit secret.
SENTRY_AUTH_TOKEN=
